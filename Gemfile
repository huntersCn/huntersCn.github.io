# frozen_string_literal: true

source "https://rubygems.org"

gem "jekyll-theme-chirpy", "~> 7.6"

platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# `wdm` is not required for `jekyll serve` on modern Windows and needs a
# local C toolchain; leaving it out keeps the site portable and easy to run.
